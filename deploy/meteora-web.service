[Unit]
Description=Meteora Terminal — веб-интерфейс (Next.js :3000)
After=network-online.target meteora-engine.service
Wants=network-online.target

[Service]
Type=simple
User=meteora
Group=meteora
WorkingDirectory=/opt/meteora-terminal/apps/web
EnvironmentFile=/opt/meteora-terminal/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=ENGINE_URL=http://127.0.0.1:8787
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npx next start -p 3000
Restart=always
RestartSec=3
StandardOutput=append:/opt/meteora-terminal/.run/web.log
StandardError=append:/opt/meteora-terminal/.run/web.log

[Install]
WantedBy=multi-user.target
