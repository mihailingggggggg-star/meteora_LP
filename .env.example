NODE_ENV=development
APP_URL=http://localhost:3000
ENGINE_URL=http://127.0.0.1:8787
ENGINE_PORT=8787
BOT_MODE=demo
DEMO_DEPOSIT_USD=500

HELIUS_API_KEY=
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com

TRADING_WALLET_PUBKEY=
TRADING_WALLET_SECRET_BASE58=
WALLET_ENCRYPTION_KEY=

# ── боевой контур: по умолчанию ВЫКЛЮЧЕН.
# Включается только при одновременном BOT_MODE=live + LIVE_EXECUTION=true + ключе кошелька.
LIVE_EXECUTION=false
# репетиция: транзакции симулируются и логируются, но НЕ отправляются
LIVE_DRY_RUN=false
LIVE_MAX_POSITION_USD=100
LIVE_MAX_POSITIONS=2
LIVE_SLIPPAGE_PCT=1.5
LIVE_PRIORITY_FEE_MICROLAMPORTS=50000
LIVE_MIN_SOL_RESERVE=0.03
LIVE_RECONCILE_MINUTES=10
LIVE_DRIFT_ALERT_PCT=5
# Telegram-алерты (ошибки транзакций, стопы, расхождение с цепочкой)
TG_BOT_TOKEN=
TG_CHAT_ID=

# AUTH_SECRET: обязателен, минимум 16 символов (openssl rand -base64 32). Без него вход заблокирован.
AUTH_SECRET=
ADMIN_EMAIL=
# Токен локального API движка (генерируется install.sh). Пусто — движок доступен только с 127.0.0.1 без токена.
ENGINE_TOKEN=
ADMIN_PASSWORD=

SIWS_DOMAIN=localhost:3000
SIWS_URI=http://localhost:3000

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
TUNNEL_NAME=meteora-terminal
TUNNEL_HOSTNAME=

GECKOTERMINAL_API_KEY=
BIRDEYE_API_KEY=
DEXSCREENER_BASE=https://api.dexscreener.com
GECKOTERMINAL_BASE=https://api.geckoterminal.com/api/v2
METEORA_DLMM_API=https://dlmm.datapi.meteora.ag
JUPITER_BASE=https://lite-api.jup.ag/swap/v1

MIN_POOL_TVL_USD=50000
TVL_VOL_RATIO_MIN=4.0
TVL_VOL_RATIO_MAX=13.0
TVL_VOL_RATIO_IDEAL=7.2
MIN_POOL_AGE_HOURS=6
MIN_VOL_1H_USD=500
TARGET_DAILY_YIELD_PCT=2.0
CLAIM_INTERVAL_HOURS=2
ROTATION_BETTER_RATIO=1.5
CLAIM_THRESHOLD_PCT=0.5
UP_BREAK_WAIT_MINUTES=5
SCAN_INTERVAL_SECONDS=300
ENTRY_COST_PCT=0.35
EXIT_COST_PCT=0.8
CAPITAL_UTILISATION=0.85

TG_BOT_TOKEN=
TG_CHAT_ID=


# ── стратегия: сетка ±2.5%, 50/50, ATR, ребалансы
MIN_TURNOVER=1.0
MAX_TURNOVER=40
MAX_ATR_PCT=6.5
POSITION_BUDGET_PCT=50
RANGE_ATR_MULT=1.5
MAX_RANGE_PCT=25.0
FRICTION_PCT=0.15
MAX_LOSS_PER_TRADE_PCT=3.0
MAX_REBALANCES_PER_DAY=8
CONSECUTIVE_LOSS_STOP=3
EARLY_EXIT_ATR_PCT=3.0
EARLY_EXIT_TURNOVER=0.8
PROFIT_TAKE_PCT=20
MAX_POSITIONS=2
MAX_POSITIONS_LARGE=2
DIVERSIFY_FROM_USD=10000
MAX_HOLD_HOURS=24
# сколько ждём возврата цены в диапазон перед ребалансом
RANGE_BREAK_MINUTES=30
# ── динамический диапазон и пересмотр пула внутри позиции
HEALTH_CHECK_MINUTES=5
FILTER_BREACH_CHECKS=2
ATR_EXIT_TOLERANCE_PCT=20
RANGE_ADJUST_MIN_PCT=20
RANGE_ADJUST_COOLDOWN_MIN=30
MIN_HOLDERS=300
MAX_DAILY_LOSS_PCT=5.0
DISTRIBUTION=uniform

# ── качество отбора и ширина диапазона (лучшая практика фарминга комиссий)
# fee/TVL за 24ч, %/сутки: ниже — позиция не окупает обслуживание (1.5–5 в рабочих агентах)
FEE_TVL_MIN_PCT=1.5
# максимальный шаг бина: грубее — диапазон даёт <9 бинов на сторону
MAX_BIN_STEP_BPS=150
# горизонт удержания: диапазон = rangeAtrMult × ATR × √(горизонт/30м)
RANGE_HORIZON_HOURS=4
# минимум/максимум бинов на сторону (18–70 бинов на позицию, дефолт программы Meteora — 70)
MIN_BINS_PER_SIDE=9
MAX_BINS_PER_SIDE=35
# издержки входа: своп в токеновую часть + слиппедж, % от суммы позиции
ENTRY_COST_PCT=0.3
# пауза на токен после 3 выходов из диапазона за 6 часов
TOKEN_COOLDOWN_HOURS=6
# жёсткий стоп: на сколько % ниже нижней границы диапазона терпим (0 = выключен)
HARD_STOP_PCT=8
